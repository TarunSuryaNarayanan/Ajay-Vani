BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_ULCA_API_KEY=your-ulca-api-key
BHASHINI_INFERENCE_KEY=your-inference-key
MODEL_BASE_URL=/models/
# Set MODEL_BASE_URL to a CDN/bucket URL to offload pack bandwidth:
# MODEL_BASE_URL=https://cdn.example.com/packs/

# ─── Twilio WhatsApp (F2: automated lifecycle nudges) ──────────────────────
# Optional: the server boots and runs without these; sends degrade to a logged
# no-op. Use a number enrolled in the Twilio WhatsApp sandbox as TWILIO_WHATSAPP_FROM.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=+15551234567
# Scheduler sweep cadence in ms (default 60000)
# LIFECYCLE_SWEEP_INTERVAL_MS=60000

# ─── Grievance forwarding (F1) ─────────────────────────────────────────────
# Optional external government portal. Leave unset to keep grievances on the
# in-app Ministry Monitoring Dashboard only.
# GOVERNMENT_PORTAL_URL=https://portal.example.gov.in/grievances

# Free key from https://www.data.gov.in/ — used only by `npm run data:fetch`
# to pull the real PMKK/ITI training-centre snapshot. Never used at runtime.
OGD_API_KEY=
